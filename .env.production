# Production Environment Configuration
NODE_ENV=production

# Application Ports
PLUGIN_HOST_PORT=3001
PLUGIN_REGISTRY_PORT=3002
PLUGIN_TEMPLATE_PORT=3003

# API Configuration
API_PREFIX=api
CORS_ENABLED=true
CORS_ORIGINS=${PRODUCTION_CORS_ORIGINS}

# Database Configuration
DATABASE_URL=${PRODUCTION_DATABASE_URL}
DATABASE_HOST=${PRODUCTION_DB_HOST}
DATABASE_PORT=${PRODUCTION_DB_PORT}
DATABASE_NAME=${PRODUCTION_DB_NAME}
DATABASE_USERNAME=${PRODUCTION_DB_USERNAME}
DATABASE_PASSWORD=${PRODUCTION_DB_PASSWORD}
DATABASE_SSL=true
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false

# Redis Configuration
REDIS_URL=${PRODUCTION_REDIS_URL}
REDIS_HOST=${PRODUCTION_REDIS_HOST}
REDIS_PORT=${PRODUCTION_REDIS_PORT}
REDIS_PASSWORD=${PRODUCTION_REDIS_PASSWORD}
REDIS_DB=0
REDIS_TTL=3600

# Security Configuration
JWT_SECRET=${PRODUCTION_JWT_SECRET}
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SECURITY_HELMET=true
SECURITY_CSRF=true
TRUST_PROXY=true
MAX_REQUEST_SIZE=10mb

# Plugin Configuration
PLUGIN_STORAGE_DIR=/app/storage/plugins
PLUGIN_MAX_COUNT=1000
PLUGIN_MAX_SIZE_MB=100
PLUGIN_ALLOWED_EXTENSIONS=.js,.ts,.json
PLUGIN_CLEANUP_INTERVAL_MS=3600000
PLUGIN_RETENTION_DAYS=90

# Registry Configuration
PLUGIN_REGISTRY_URL=${PRODUCTION_REGISTRY_URL}
PLUGIN_REGISTRY_API_KEY=${PRODUCTION_REGISTRY_API_KEY}
PLUGIN_REGISTRY_TIMEOUT=30000

# Logging Configuration
LOG_LEVEL=warn
LOG_FORMAT=json
LOG_CONSOLE=false
LOG_FILE=true
LOG_DIRECTORY=/app/logs

# Health Check Configuration
HEALTH_ENDPOINT=/health
HEALTH_TIMEOUT=30000
HEALTH_DISK=true
HEALTH_MEMORY=true

# Rate Limiting
RATE_LIMITING_ENABLED=true
RATE_LIMITING_WINDOW_MS=900000
RATE_LIMITING_MAX_REQUESTS=5000

# Monitoring
METRICS_ENABLED=true
METRICS_PORT=9090
TRACING_ENABLED=true
JAEGER_ENDPOINT=${PRODUCTION_JAEGER_ENDPOINT}