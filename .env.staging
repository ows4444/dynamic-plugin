# Staging Environment Configuration
NODE_ENV=staging

# Application Ports
PLUGIN_HOST_PORT=3001
PLUGIN_REGISTRY_PORT=3002
PLUGIN_TEMPLATE_PORT=3003

# API Configuration
API_PREFIX=api
CORS_ENABLED=true
CORS_ORIGINS=https://staging.example.com

# Database Configuration
DATABASE_URL=postgresql://plugin_user:${DATABASE_PASSWORD}@staging-db:5432/plugin_system_staging
DATABASE_HOST=staging-db
DATABASE_PORT=5432
DATABASE_NAME=plugin_system_staging
DATABASE_USERNAME=plugin_user
DATABASE_PASSWORD=${STAGING_DB_PASSWORD}
DATABASE_SSL=true
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false

# Redis Configuration
REDIS_URL=redis://staging-redis:6379
REDIS_HOST=staging-redis
REDIS_PORT=6379
REDIS_PASSWORD=${STAGING_REDIS_PASSWORD}
REDIS_DB=0
REDIS_TTL=3600

# Security Configuration
JWT_SECRET=${STAGING_JWT_SECRET}
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
SECURITY_HELMET=true
SECURITY_CSRF=true
TRUST_PROXY=true
MAX_REQUEST_SIZE=10mb

# Plugin Configuration
PLUGIN_STORAGE_DIR=/app/storage/plugins
PLUGIN_MAX_COUNT=500
PLUGIN_MAX_SIZE_MB=100
PLUGIN_ALLOWED_EXTENSIONS=.js,.ts,.json
PLUGIN_CLEANUP_INTERVAL_MS=3600000
PLUGIN_RETENTION_DAYS=30

# Registry Configuration
PLUGIN_REGISTRY_URL=http://plugin-registry:3002
PLUGIN_REGISTRY_API_KEY=${STAGING_REGISTRY_API_KEY}
PLUGIN_REGISTRY_TIMEOUT=30000

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_CONSOLE=true
LOG_FILE=true
LOG_DIRECTORY=/app/logs

# Health Check Configuration
HEALTH_ENDPOINT=/health
HEALTH_TIMEOUT=30000
HEALTH_DISK=true
HEALTH_MEMORY=true

# Rate Limiting
RATE_LIMITING_ENABLED=true
RATE_LIMITING_WINDOW_MS=900000
RATE_LIMITING_MAX_REQUESTS=1000

# Monitoring
METRICS_ENABLED=true
METRICS_PORT=9090
TRACING_ENABLED=true
JAEGER_ENDPOINT=http://jaeger:14268/api/traces