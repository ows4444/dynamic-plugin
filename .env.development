# Development Environment Configuration
NODE_ENV=development

# Application Ports
PLUGIN_HOST_PORT=3001
PLUGIN_REGISTRY_PORT=3002
PLUGIN_TEMPLATE_PORT=3003

# API Configuration
API_PREFIX=api
CORS_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/plugin_system_dev
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=plugin_system_dev
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=password
DATABASE_SSL=false
DATABASE_SYNCHRONIZE=true
DATABASE_LOGGING=true

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# Security Configuration
JWT_SECRET=dev-secret-key-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
SECURITY_HELMET=true
SECURITY_CSRF=false
TRUST_PROXY=true
MAX_REQUEST_SIZE=10mb

# Plugin Configuration
PLUGIN_STORAGE_DIR=./storage/plugins
PLUGIN_MAX_COUNT=100
PLUGIN_MAX_SIZE_MB=50
PLUGIN_ALLOWED_EXTENSIONS=.js,.ts,.json
PLUGIN_CLEANUP_INTERVAL_MS=3600000
PLUGIN_RETENTION_DAYS=30

# Registry Configuration
PLUGIN_REGISTRY_URL=http://localhost:3002
PLUGIN_REGISTRY_API_KEY=dev-api-key
PLUGIN_REGISTRY_TIMEOUT=30000

# Logging Configuration
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_CONSOLE=true
LOG_FILE=false
LOG_DIRECTORY=./logs

# Health Check Configuration
HEALTH_ENDPOINT=/health
HEALTH_TIMEOUT=30000
HEALTH_DISK=true
HEALTH_MEMORY=true

# Rate Limiting
RATE_LIMITING_ENABLED=true
RATE_LIMITING_WINDOW_MS=900000
RATE_LIMITING_MAX_REQUESTS=1000

# Monitoring
METRICS_ENABLED=true
METRICS_PORT=9090
TRACING_ENABLED=false
JAEGER_ENDPOINT=http://localhost:14268/api/traces