# Test Environment Configuration
NODE_ENV=test

# Application Ports
PLUGIN_HOST_PORT=3011
PLUGIN_REGISTRY_PORT=3012
PLUGIN_TEMPLATE_PORT=3013

# API Configuration
API_PREFIX=api
CORS_ENABLED=true
CORS_ORIGINS=http://localhost:3000

# Database Configuration
DATABASE_URL=postgresql://test:test@localhost:5432/plugin_system_test
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=plugin_system_test
DATABASE_USERNAME=test
DATABASE_PASSWORD=test
DATABASE_SSL=false
DATABASE_SYNCHRONIZE=true
DATABASE_LOGGING=false

# Redis Configuration
REDIS_URL=redis://localhost:6380
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=1
REDIS_TTL=300

# Security Configuration
JWT_SECRET=test-secret-key
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=1d
SECURITY_HELMET=false
SECURITY_CSRF=false
TRUST_PROXY=false
MAX_REQUEST_SIZE=5mb

# Plugin Configuration
PLUGIN_STORAGE_DIR=./test-storage/plugins
PLUGIN_MAX_COUNT=10
PLUGIN_MAX_SIZE_MB=5
PLUGIN_ALLOWED_EXTENSIONS=.js,.ts,.json
PLUGIN_CLEANUP_INTERVAL_MS=60000
PLUGIN_RETENTION_DAYS=1

# Registry Configuration
PLUGIN_REGISTRY_URL=http://localhost:3012
PLUGIN_REGISTRY_API_KEY=test-api-key
PLUGIN_REGISTRY_TIMEOUT=5000

# Logging Configuration
LOG_LEVEL=error
LOG_FORMAT=simple
LOG_CONSOLE=false
LOG_FILE=false
LOG_DIRECTORY=./test-logs

# Health Check Configuration
HEALTH_ENDPOINT=/health
HEALTH_TIMEOUT=5000
HEALTH_DISK=false
HEALTH_MEMORY=false

# Rate Limiting
RATE_LIMITING_ENABLED=false
RATE_LIMITING_WINDOW_MS=60000
RATE_LIMITING_MAX_REQUESTS=100

# Monitoring
METRICS_ENABLED=false
METRICS_PORT=9091
TRACING_ENABLED=false
JAEGER_ENDPOINT=